"""TCS stock data analysis and prediction project.

This script reads the provided TCS CSV files, builds a small set of
technical indicators, compares a few regression models, and saves plots
and a summary report in the workspace.
"""

# pyright: reportMissingImports=false

from __future__ import annotations

import json
from pathlib import Path

import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_absolute_percentage_error, mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler


BASE_DIR = Path(__file__).resolve().parent
DATA_CANDIDATES = [BASE_DIR, Path(r"C:/Users/pc/Downloads")]
OUTPUT_DIR = BASE_DIR / "tcs_outputs"


def resolve_path(filename: str) -> Path:
	for directory in DATA_CANDIDATES:
		candidate = directory / filename
		if candidate.exists():
			return candidate
	raise FileNotFoundError(f"Could not find {filename} in the project folder or Downloads")


def load_history() -> pd.DataFrame:
	history = pd.read_csv(resolve_path("TCS_stock_history.csv"))
	history["Date"] = pd.to_datetime(history["Date"], errors="coerce")
	history = history.dropna(subset=["Date"]).sort_values("Date").reset_index(drop=True)
	numeric_columns = ["Open", "High", "Low", "Close", "Volume", "Dividends", "Stock Splits"]
	for column in numeric_columns:
		if column in history.columns:
			history[column] = pd.to_numeric(history[column], errors="coerce")
	history = history.ffill().bfill()
	return history


def load_actions() -> pd.DataFrame:
	actions = pd.read_csv(resolve_path("TCS_stock_action.csv"))
	actions["Date"] = pd.to_datetime(actions["Date"], errors="coerce")
	return actions.dropna(subset=["Date"]).sort_values("Date").reset_index(drop=True)


def load_info() -> pd.DataFrame:
	return pd.read_csv(resolve_path("TCS_stock_info.csv"), header=None, names=["key", "value"])


def build_features(history: pd.DataFrame) -> pd.DataFrame:
	data = history.copy()
	data["Daily_Return"] = data["Close"].pct_change() * 100
	data["Price_Range"] = data["High"] - data["Low"]
	data["Intraday_Change"] = data["Close"] - data["Open"]
	data["MA_20"] = data["Close"].rolling(window=20).mean()
	data["MA_50"] = data["Close"].rolling(window=50).mean()
	data["MA_200"] = data["Close"].rolling(window=200).mean()
	data["Volatility_20"] = data["Daily_Return"].rolling(window=20).std()
	data["Next_Close"] = data["Close"].shift(-1)
	return data.dropna().reset_index(drop=True)


def evaluate_model(name: str, model, x_test, y_test) -> dict:
	predictions = model.predict(x_test)
	return {
		"Model": name,
		"MAE": float(mean_absolute_error(y_test, predictions)),
		"RMSE": float(mean_squared_error(y_test, predictions) ** 0.5),
		"MAPE": float(mean_absolute_percentage_error(y_test, predictions)),
		"R2": float(r2_score(y_test, predictions)),
		"Predictions": predictions,
	}


def save_plot(path: Path) -> None:
	path.parent.mkdir(parents=True, exist_ok=True)
	plt.tight_layout()
	plt.savefig(path, dpi=120, bbox_inches="tight")
	plt.close()


def main() -> None:
	sns.set_theme(style="whitegrid", context="talk")
	OUTPUT_DIR.mkdir(exist_ok=True)

	history = load_history()
	actions = load_actions()
	info = load_info()

	print("TCS Stock Data Analysis")
	print("=" * 40)
	print(f"History rows: {len(history):,}")
	print(f"Action rows: {len(actions):,}")
	print(f"Info rows: {len(info):,}")
	print(f"Date range: {history['Date'].min().date()} to {history['Date'].max().date()}")

	summary = {
		"rows": int(len(history)),
		"start_date": str(history["Date"].min().date()),
		"end_date": str(history["Date"].max().date()),
		"close_min": float(history["Close"].min()),
		"close_max": float(history["Close"].max()),
		"close_mean": float(history["Close"].mean()),
		"total_dividends": float(actions["Dividends"].sum()),
		"dividend_events": int((actions["Dividends"] > 0).sum()),
		"stock_split_events": int((actions["Stock Splits"] > 0).sum()),
		"sector": str(info.loc[info["key"] == "sector", "value"].iloc[0]) if (info["key"] == "sector").any() else "Unknown",
		"industry": str(info.loc[info["key"] == "industry", "value"].iloc[0]) if (info["key"] == "industry").any() else "Unknown",
	}

	feature_data = build_features(history)
	feature_columns = [
		"Open",
		"High",
		"Low",
		"Volume",
		"Dividends",
		"Stock Splits",
		"Price_Range",
		"Intraday_Change",
		"MA_20",
		"MA_50",
		"MA_200",
		"Volatility_20",
	]
	x = feature_data[feature_columns]
	y = feature_data["Next_Close"]

	split_index = int(len(feature_data) * 0.8)
	x_train_raw, x_test_raw = x.iloc[:split_index], x.iloc[split_index:]
	y_train, y_test = y.iloc[:split_index], y.iloc[split_index:]

	scaler = StandardScaler()
	x_train = scaler.fit_transform(x_train_raw)
	x_test = scaler.transform(x_test_raw)

	models = {
		"Linear Regression": LinearRegression(),
		"Random Forest": RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1),
		"Gradient Boosting": GradientBoostingRegressor(random_state=42),
	}

	results = []
	fitted_models = {}
	for name, model in models.items():
		model.fit(x_train, y_train)
		fitted_models[name] = model
		result = evaluate_model(name, model, x_test, y_test)
		results.append({k: v for k, v in result.items() if k != "Predictions"})
		print(f"{name}: R2={result['R2']:.4f}, MAE={result['MAE']:.4f}, RMSE={result['RMSE']:.4f}")

	results_df = pd.DataFrame(results).sort_values(by="R2", ascending=False).reset_index(drop=True)
	best_model_name = str(results_df.loc[0, "Model"])
	best_model = fitted_models[best_model_name]
	best_predictions = best_model.predict(x_test)

	plt.figure(figsize=(14, 6))
	plt.plot(history["Date"], history["Close"], color="#1f4e79", linewidth=1.8, label="Close")
	plt.plot(feature_data["Date"], feature_data["MA_20"], color="#d95f02", linewidth=1.2, label="MA 20")
	plt.plot(feature_data["Date"], feature_data["MA_50"], color="#2ca02c", linewidth=1.2, label="MA 50")
	plt.title("TCS Closing Price with Moving Averages")
	plt.xlabel("Date")
	plt.ylabel("Price")
	plt.legend()
	save_plot(OUTPUT_DIR / "tcs_price_trend.png")

	plt.figure(figsize=(12, 6))
	sns.histplot(feature_data["Daily_Return"], bins=50, kde=True, color="#4c78a8")
	plt.title("Distribution of Daily Returns")
	plt.xlabel("Daily Return (%)")
	save_plot(OUTPUT_DIR / "tcs_return_distribution.png")

	plt.figure(figsize=(14, 6))
	test_dates = feature_data["Date"].iloc[split_index:].reset_index(drop=True)
	plt.plot(test_dates, y_test.reset_index(drop=True), label="Actual", linewidth=2)
	plt.plot(test_dates, best_predictions, label=f"Predicted ({best_model_name})", linewidth=2)
	plt.title("Actual vs Predicted Next-Day Close")
	plt.xlabel("Date")
	plt.ylabel("Price")
	plt.legend()
	save_plot(OUTPUT_DIR / "tcs_actual_vs_predicted.png")

	if hasattr(best_model, "feature_importances_"):
		importance_df = pd.DataFrame({"Feature": feature_columns, "Importance": best_model.feature_importances_}).sort_values(by="Importance", ascending=False)
		plt.figure(figsize=(10, 7))
		sns.barplot(data=importance_df.head(10), x="Importance", y="Feature", color="#4c78a8")
		plt.title("Feature Importance")
		save_plot(OUTPUT_DIR / "tcs_feature_importance.png")
	else:
		importance_df = pd.DataFrame(columns=["Feature", "Importance"])

	summary.update(
		{
			"best_model": best_model_name,
			"best_r2": float(results_df.loc[0, "R2"]),
			"best_mae": float(results_df.loc[0, "MAE"]),
			"best_rmse": float(results_df.loc[0, "RMSE"]),
			"best_mape": float(results_df.loc[0, "MAPE"]),
			"top_features": importance_df.head(5).to_dict(orient="records"),
		}
	)

	results_df.to_csv(OUTPUT_DIR / "model_comparison.csv", index=False)
	importance_df.to_csv(OUTPUT_DIR / "feature_importance.csv", index=False)
	(OUTPUT_DIR / "summary.json").write_text(json.dumps(summary, indent=2), encoding="utf-8")

	print("\nSummary")
	print("-" * 40)
	for key, value in summary.items():
		if key == "top_features":
			continue
		print(f"{key}: {value}")
	print(f"\nOutputs saved to: {OUTPUT_DIR}")


if __name__ == "__main__":
	main()
